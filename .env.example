# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Settings → API → service_role (keep secret!). Required for
# the Users page to create/remove username+password logins for other
# people. Server-only — never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for receipt extraction
# CLAUDE_MODEL=claude-sonnet-5

# The deployed app's URL — used to build the magic-link redirect.
# Local dev:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# In Vercel, set this to your production URL instead, e.g.
# NEXT_PUBLIC_SITE_URL=https://badminton-ledger-app.vercel.app
